+
+# B3: every tile is flat, so a flush friction patch stays flush as the
+# curriculum promotes. Same grid shape as BUMPY (size, rows, cols, border),
+# otherwise the robots would land on a different origin layout than the
+# placement probe measures.
+ICE_TERRAINS_CFG = BUMPY_TERRAINS_CFG.replace(
+    sub_terrains={
+        "flat": terrain_gen.HfPyramidSlopedTerrainCfg(
+            proportion=1.0, slope_range=(0.0, 0.0), platform_width=2.0, border_width=0.25,
+        ),
+    }
+)
