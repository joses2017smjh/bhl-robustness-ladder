# Environment artifacts live outside the tree, but guard against strays.
.venv/
venv/
.uv-cache/
.uv-python/
.cache/
.home/

# Container image (293MB) is a build product of container/bhl.def
*.sif

# Training output
logs/
# `runs/` was a scratch output directory; it is now the migrated record of
# every training run, so the manifest and configs are tracked and only the
# oversized curve dump is not.
runs/*
!runs/params/
!runs/manifest.csv
outputs/
checkpoints/
*.pt
*.onnx

# Results: keep aggregated CSV + plots, drop raw per-step dumps
results/raw/
results/**/*.npz
# `checkpoints/` above is for training output and is unanchored, so it also
# swallowed results/checkpoints -- the per-iteration transfer scores, which are
# aggregated CSVs like every other results/ subdirectory and belong in the repo.
!results/checkpoints/
!results/checkpoints/*.csv

__pycache__/
*.py[cod]
.ipynb_checkpoints/
.DS_Store

# Bulk rendered clips: ~500KB each and dozens per eval sweep. Download the
# good ones for the portfolio rather than versioning them.
results/video/
docs/gifs/*.mp4
docs/gifs/_frame_*.png

# Generated USD crates can be large; the .usda lab scene is the readable one.
results/usd/*.usdc

# Raw per-step TensorBoard dump (~300k rows). curves.json is the derived,
# downsampled artifact the charts and dashboard actually read.
results/curves/training_curves.csv

# Paired README GIFs are figures, not bulk output -- keep them.
!docs/gifs/
!docs/gifs/*.gif

# Editor / IDE workspace state -- local to whoever opened the repo.
.vscode/
*.code-workspace

# Migration staging; the archives live as GitHub Release assets, not in git.
/runs/*.tar.zst
# Long-form curves outgrew GitHub's 100 MB per-file limit; it is a release asset.
/runs/scalars.csv.gz

# Raw Isaac maze renders are ~120 MB each at 1280x720 -- over GitHub's 100 MB
# file limit. The committed artefacts are the downscaled composite gif/mp4 in
# docs/gifs; the raw clips stay on the cluster (slurm/97_maze_video.sbatch).
results/clips/maze_*.mp4
# PNG frame dumps from the camera-sensor clip recorder; the gif is the artefact.
results/clips/frames/
# Render-probe frames (25 MB) and raw Isaac logs stay local; the JSON measurements are committed.
results/render_probe/*.png
results/render_probe/*.log

# Weekend campaign: retain small verdicts/manifests, never vendor environments,
# policy weights/optimizers, render caches or scheduler stdout.
results/weekend-*/deps/
results/weekend-*/fold-*/step_*/
results/weekend-*/fold-*/.step_*.pending/
results/weekend-*/*_frames/
results/weekend-*/*.out

# Mission7 runtime snapshots, model caches and scheduler logs; retain verdicts.
results/mission7-*/source/
results/mission7-*/source-*/
results/mission7-*/**/*cache*/
results/mission7-dev/
results/mission7-*/*.out
# Raw per-step traces from Mission 7 probes.  Ignored by the SHAPE the probes
# emit, not one filename at a time: the old list named only episodes.json, and
# when the route probes started writing routes.json, doors-<n>.json and whole
# episode rows into result.json it silently stopped covering them, leaving
# 1.4 GB stageable by a single `git add -A`.  Compact verdicts and receipts are
# re-included below and stay in the repo.
results/mission7-*/**/*episodes*.json
results/mission7-*/**/*episodes*.jsonl
results/mission7-*/**/*routes*.json
results/mission7-*/**/*doors*.json
results/mission7-*/**/*transport*.json
results/mission7-*/**/*-trace.json
results/mission7-*/**/*_trace.json
results/mission7-*/**/*standstill*.json
results/mission7-*/**/*validation-*.json
results/mission7-*/**/pulse.json
results/mission7-*/**/replay/

# The 2026-09-21 Approach diagnosis is a closed investigation whose raw
# per-episode JSON stays on the cluster; nothing in it was ever tracked.
# Compact artifacts are re-included by the negations above and below.
results/mission7-approach-debug-20260921/**/*.json
!results/mission7-approach-debug-20260921/**/*summary*.json
!results/mission7-approach-debug-20260921/**/qualification.json
!results/mission7-*/**/*summary*.json
!results/mission7-*/**/*_summary.json
!results/mission7-*/**/submission.json
!results/mission7-*/**/sha256.json
results/mission7-*/**/source-*/
# Per-job source snapshots nested under a campaign dir; reproducible from each
# submission.json's commit and sha256 list.
results/mission7-*/**/source/
results/mission7-*/**/*.out
results/mission7-*/**/*.log

# Raw traces written into result.json before the probe was changed to keep
# result.json compact (traces now stay in <stage>-<index>.json).  Finite and
# enumerated on purpose; tests/test_result_artifacts.py fails the suite if a
# new oversized artifact appears instead of being compacted.
results/mission7-approach-debug-20260921/approach_recovery/result.json
results/mission7-approach-debug-20260921/c4/update-100/result.json
results/mission7-approach-debug-20260921/c4/update-125/result.json
results/mission7-approach-debug-20260921/c4/update-75/result.json
results/mission7-approach-debug-20260921/gait-0/result.json
results/mission7-approach-debug-20260921/gait-1/result.json
results/mission7-approach-debug-20260921/gait-2/result.json
results/mission7-approach-debug-20260921/gait_endurance/result.json
results/mission7-approach-followup-20260922-early/route-early-handoff-cn-c22/result.json
results/mission7-approach-followup-20260922-rejoin-fix/route-rejoin-fix-cn-c22/result.json
results/mission7-approach-followup-20260922-rejoin/route-rejoin-diagnostic-cn-c22/result.json
results/mission7-approach-followup-20260922/route-rejoin-fix-v2-cn-c22/result.json
