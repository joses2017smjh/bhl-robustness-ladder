# Environment artifacts live outside the tree, but guard against strays.
.venv/
venv/
.uv-cache/
.uv-python/
.cache/
.home/

# Container image (293MB) is a build product of container/bhl.def
*.sif

# Training output
logs/
# `runs/` was a scratch output directory; it is now the migrated record of
# every training run, so the manifest and configs are tracked and only the
# oversized curve dump is not.
runs/*
!runs/params/
!runs/manifest.csv
outputs/
checkpoints/
*.pt
*.onnx

# Results: keep aggregated CSV + plots, drop raw per-step dumps
results/raw/
results/**/*.npz
# `checkpoints/` above is for training output and is unanchored, so it also
# swallowed results/checkpoints -- the per-iteration transfer scores, which are
# aggregated CSVs like every other results/ subdirectory and belong in the repo.
!results/checkpoints/
!results/checkpoints/*.csv

__pycache__/
*.py[cod]
.ipynb_checkpoints/
.DS_Store

# Bulk rendered clips: ~500KB each and dozens per eval sweep. Download the
# good ones for the portfolio rather than versioning them.
results/video/
docs/gifs/*.mp4
docs/gifs/_frame_*.png

# Generated USD crates can be large; the .usda lab scene is the readable one.
results/usd/*.usdc

# Raw per-step TensorBoard dump (~300k rows). curves.json is the derived,
# downsampled artifact the charts and dashboard actually read.
results/curves/training_curves.csv

# Paired README GIFs are figures, not bulk output -- keep them.
!docs/gifs/
!docs/gifs/*.gif

# Editor / IDE workspace state -- local to whoever opened the repo.
.vscode/
*.code-workspace

# Migration staging; the archives live as GitHub Release assets, not in git.
/runs/*.tar.zst
# Long-form curves outgrew GitHub's 100 MB per-file limit; it is a release asset.
/runs/scalars.csv.gz

# Raw Isaac maze renders are ~120 MB each at 1280x720 -- over GitHub's 100 MB
# file limit. The committed artefacts are the downscaled composite gif/mp4 in
# docs/gifs; the raw clips stay on the cluster (slurm/97_maze_video.sbatch).
results/clips/maze_*.mp4
