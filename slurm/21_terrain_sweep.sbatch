#!/bin/bash
#SBATCH --job-name=terr-sweep
#SBATCH --account=eecs
#SBATCH --partition=gpu
#SBATCH --cpus-per-task=4
#SBATCH --mem=48G
#SBATCH --gres=gpu:1
#SBATCH --time=08:00:00
#SBATCH --output=/nfs/hpc/share/sanchej7/Humanoid_Lite/logs/%x-%j.out
#SBATCH --error=/nfs/hpc/share/sanchej7/Humanoid_Lite/logs/%x-%j.out

# Terrain retention curve: score each policy across MuJoCo ground roughness.
#
# Training terrain (Isaac Lab height fields) and evaluation terrain (MuJoCo
# hfield) are generated by entirely different code. That is deliberate -- a
# policy that only copes with the exact surface it trained on has memorised,
# not learned. What the two share is the physical envelope: amplitude, gradient
# and obstacle height are matched to the training sub-terrain menu.
#
# The difficulty grid is dense at the low end because that is where the flat-
# trained baseline actually breaks: dr-off falls 8% at d=0, 58% at d=0.05 and
# 92% by d=0.10. Sampling uniformly to 1.0 would spend most of the budget in a
# region where every policy already fails.
#
# Only the terrain arms and the flat baselines are swept; the DR rungs are a
# separate question and are scored on flat ground by 20_evaluate_all.

set -euo pipefail
source /nfs/hpc/share/$USER/Humanoid_Lite/bhl-robustness-ladder/slurm/_env.sh
setup_node_cache

export MUJOCO_GL=egl PYOPENGL_PLATFORM=egl OMP_NUM_THREADS=4
export CACHE_DIR=$WORKSPACE/mjcf_cache
export BHL_FORWARD_VARS="$BHL_FORWARD_VARS TERRAIN_D RUN_DIR"
mkdir -p "$REPO/results/terrain" "$REPO/results/video"

LOGROOT=$UPSTREAM/logs/rsl_rl/biped
DIFFS="0.0 0.05 0.10 0.20 0.40"

for run in "$LOGROOT"/*/; do
    name=$(basename "$run"); [ "$name" = isaaclab ] && continue
    label=$(echo "$name" | sed 's/^[0-9-]*_[0-9-]*_//')
    case "$label" in
        terrain-*|dr-off-*|dr-default-*) ;;
        *) continue ;;
    esac
    ls "$run"/model_*.pt >/dev/null 2>&1 || continue

    if [ ! -f "$run/exported/policy.onnx" ]; then
        export RUN_DIR=$name
        bhl_exec "$REPO/slurm/inner/export_one.sh" >/dev/null 2>&1 || true
    fi
    [ -f "$run/exported/deploy.yaml" ] || { echo "no export: $label"; continue; }

    for d in $DIFFS; do
        echo "=== $label @ terrain d=$d ==="
        export DEPLOY_CFG=$run/exported/deploy.yaml
        export OUT_CSV=$REPO/results/terrain/${label}__d${d}.csv
        export LABEL=$label EPISODE_S=10 N_SEEDS=5 PUSH_SPEED=0 TERRAIN_D=$d
        # Film only the mid rung, else the clip count explodes.
        if [ "$d" = "0.20" ]; then export VIDEO_DIR=$REPO/results/video; else export VIDEO_DIR=""; fi
        bhl_exec "$REPO/slurm/inner/eval_one.sh" 2>&1 | grep -E "falls|video ->" || true
    done
done

echo "=== terrain sweep done: $(date) ==="
ls -1 "$REPO/results/terrain"/*.csv 2>/dev/null | wc -l | sed 's/^/csv files: /'
